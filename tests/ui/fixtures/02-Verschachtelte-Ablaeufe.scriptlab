{
  "schemaVersion": 1,
  "appVersion": "0.1.0",
  "name": "UI-Test: Verschachtelte Abläufe",
  "beschreibung": "Reine Darstellungstestdaten: äußere Schleife, innere Bedingung und zusätzliche innere Schleife. Kein Scriptstart.",
  "editor": {
