                                    "fields": {
                                      "ZAHL": "2"
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "DANN": {
                            "block": {
                              "type": "sl_repeat",
                              "id": "ui-innere-schleife",
                              "inputs": {
                                "ANZAHL": {
                                  "block": {
                                    "type": "sl_number",
                                    "id": "ui-innere-anzahl",
                                    "fields": {
                                      "ZAHL": "2"
                                    }
                                  }
                                },
                                "ABLAUF": {
