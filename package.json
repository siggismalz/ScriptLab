{
  "name": "scriptlab",
  "productName": "ScriptLab",
  "version": "0.2.0",
  "description": "Visueller Baukasten für Windows-Automatisierungen. Entwickelt von Leon Stolz.",
  "author": "Leon Stolz",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.txt",
  "type": "module",
  "main": "dist/main/hauptprozess.cjs",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/siggismalz/ScriptLab.git"
  },
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "node scripts/bauen.mjs",
    "package": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:dir": "npm run build && electron-builder --win --x64 --dir --publish never",
    "verify:package": "node scripts/pruefe-bau.mjs"
  },
  "dependencies": {
    "blockly": "13.4.0",
    "electron-updater": "6.8.11",
    "js-yaml": "5.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
