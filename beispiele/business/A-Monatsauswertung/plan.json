    {"id":"a-pdf","operation":"dokument.pdf_bericht","konfiguration":{"ziel":{"parameter":"PDF_Ziel"},"schrift":{"parameter":"Schriftdatei"},"titel":"Monatsauswertung – synthetische Testdaten","spalten":["Region","Datensätze","Betrag"],"konflikt":"FEHLER"},"eingaben":{"tabelle":{"referenz":"a-ergebnis"}}}
