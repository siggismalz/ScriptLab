    {"id":"a-monat","operation":"daten.filtern","konfiguration":{"bedingung":{"art":"vergleich","spalte":"Datum","operator":"BEGINNT","wert":{"art":"wert","typ":"TEXT","wert":{"parameter":"Berichtsmonat"}}}},"eingaben":{"tabelle":{"referenz":"a-betrag"}}},
    {"id":"a-regionen","operation":"daten.gruppieren","konfiguration":{"schluessel":["Region"],"aggregate":[{"funktion":"ANZAHL","name":"Datensätze"},{"funktion":"SUMME","spalte":"Betrag","name":"Betrag"}]},"eingaben":{"tabelle":{"referenz":"a-monat"}}},
    {"id":"a-sortieren","operation":"daten.sortieren","konfiguration":{"schluessel":[{"spalte":"Region","richtung":"ASC","nullen":"LETZTE"}]},"eingaben":{"tabelle":{"referenz":"a-regionen"}}},
    {"id":"a-gesamt","operation":"daten.gruppieren","konfiguration":{"schluessel":[],"aggregate":[{"funktion":"ANZAHL","name":"Datensätze"},{"funktion":"SUMME","spalte":"Betrag","name":"Betrag"}]},"eingaben":{"tabelle":{"referenz":"a-monat"}}},
    {"id":"a-gesamtname","operation":"daten.spalten","konfiguration":{"aktion":"BERECHNEN","spalte":"Region","ausdruck":{"art":"wert","typ":"TEXT","wert":"Gesamt"}},"eingaben":{"tabelle":{"referenz":"a-gesamt"}}},
    {"id":"a-ergebnis","operation":"daten.vereinigen","konfiguration":{"nach_name":true,"dubletten":false},"eingaben":{"links":{"referenz":"a-sortieren"},"rechts":{"referenz":"a-gesamtname"}}},
